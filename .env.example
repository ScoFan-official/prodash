# Prodash 后端环境变量示例。复制为 .env 并修改。
PORT=8787

# MySQL（见 docker-compose.yml）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prodash
DB_PASSWORD=prodash
DB_NAME=prodash

# Dify（日报生成服务，后续任务接入）
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_USER=prodash
DIFY_TIMEOUT_MS=30000
DIFY_MOCK=true

# 发布器（后续任务接入）
PUBLISHER=mock
DINGTALK_WIKI_WS_ID=
DINGTALK_WIKI_FOLDER_ID=
DWS_BIN=dws
# PUBLISHER=file 时输出目录（可选，默认 reports-output/）
REPORTS_OUTPUT_DIR=

# 日报定时调度（后续任务接入），cron 语法：每天 21:00
REPORT_CRON=0 21 * * *
