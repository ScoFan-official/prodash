# Prodash 后端环境变量示例。复制为 .env 并修改。
PORT=8787

# MySQL（见 docker-compose.yml）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=prodash
DB_PASSWORD=prodash
DB_NAME=prodash

# Dify（日报生成服务，后续任务接入）
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_USER=prodash
DIFY_TIMEOUT_MS=30000
DIFY_MOCK=true

# 发布器（后续任务接入）
PUBLISHER=mock
DINGTALK_WIKI_WS_ID=
DINGTALK_WIKI_FOLDER_ID=
# 日报发布目标组织 profile（corpId:userId）；跨组织发布必须配置，否则 forbidden.accessDenied
DINGTALK_WIKI_PROFILE=
DWS_BIN=dws
# Windows 下 dws 常以 .cmd/.bat shim 分发，execFile 直调会 ENOENT；
# 此时 DWS_BIN=node 的解释器路径 + DWS_SCRIPT=dws CLI 的 JS 入口（如 .../dingtalk-workspace-cli/bin/dws.js）
DWS_SCRIPT=
# PUBLISHER=file 时输出目录（可选，默认 reports-output/）
REPORTS_OUTPUT_DIR=

# 日报定时调度（后续任务接入），cron 语法：每天 21:00
REPORT_CRON=0 21 * * *

# 钉钉待办同步：来源组织 profile（corpId:userId 格式，必须显式配置，未配置同步 fail-fast 报错）
DINGTALK_TODO_PROFILE=ding4108cf4d27f89345acaaa37764f94726:17857219403578277
# 钉钉待办拉取轮询 cron（默认每 30 分钟）
DINGTALK_TODO_SYNC_CRON=*/30 * * * *
